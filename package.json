{
  "name": "tower-rts",
  "version": "0.1.0",
  "private": true,
  "description": "Fallout Shelter tower building + StarCraft macro: two towers, one lane.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "build": "node tools/build.ts",
    "serve": "node tools/serve.ts dist",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "match": "node tools/match.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "6.0.3"
  }
}
